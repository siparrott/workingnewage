# Environment for the New Age Fotografie service on Render.
#
# HOW TO USE: copy this file to .env.render (which .gitignore covers), fill in the
# blanks from Heroku, then Render -> Environment -> "Add from .env" and paste it.
# Do NOT fill this file in place: it is tracked by git, and .env.development and
# .env.netlify in this repo are tracked too — env-shaped does not mean ignored.
#
# Generated from migration/render-newage.yaml so the two cannot drift.
# Keys are grouped as they are there; the comments on the dangerous ones are kept.


# ---- Runtime ----
NODE_ENV=production
DEMO_MODE=false
AUTO_INIT_SCHEMA=true
PRERENDER=true

# ---- The two that must be COPIED, never generated ----
SESSION_SECRET=
ENCRYPTION_KEY=

# ---- Database ----
DATABASE_URL=

# ---- Identity and canonical URL ----
PUBLIC_SITE_URL=
SITE_URL=
BASE_URL=
BUSINESS_NAME=
CONTACT_EMAIL=
BUSINESS_PHONE=

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=

# ---- Storage (Backblaze B2 via the S3 API) ----
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Email ----
SMTP_USER=
SMTP_PASS=
BUSINESS_MAILBOX_USER=
EMAIL_PASSWORD=

# ---- Integrations ----
OPENAI_API_KEY=
SHOOTCLEANER_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=
BREVO_API_KEY=
BREVO_WHATSAPP_SENDER=
INBOX_IMAP_HOST=
INBOX_IMAP_PORT=
INBOX_IMAP_USER=
INBOX_IMAP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SYNC_ENABLED=
GALLERY_INVISIBLE_KEY=
GALLERY_WATERMARK_TEXT=
